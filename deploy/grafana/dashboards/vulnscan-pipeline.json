    {
      "type": "timeseries",
      "title": "Ответы пользователю",
      "description": "`source` различает вебхук и опрос: право ответить разыгрывается один раз, задвоений быть не должно.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
