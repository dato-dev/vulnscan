        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vs_input_bytes_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vs_input_bytes_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Нет данных. Проверьте, что цель скрейпится: /targets в Prometheus.",
