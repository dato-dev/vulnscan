# Выход наружу через прокси. Скопируйте в proxy.env и заполните на сервере.
#
#   cp proxy.env.example proxy.env
#
# Файл читают ТОЛЬКО бот и clamd — те, кому связь наружу нужна по назначению:
# бот ходит в Telegram, clamd обновляет базы. Воркер, разбирающий недоверенные
# файлы, этих переменных не получает и выхода наружу не имеет.
#
# Файла может не быть — тогда всё ходит напрямую.
#
# ВАЖНО про схему: http:// даже для HTTPS-трафика. Клиент открывает обычное
# соединение с прокси и просит CONNECT. `https://` означало бы TLS до самого
# прокси, чего почти никто не умеет, и попытка кончится таймаутом.

HTTP_PROXY=http://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ
HTTPS_PROXY=http://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ

# Внутренние адреса мимо прокси. Без этого запрос бота к gateway ушёл бы
# наружу и не вернулся: прокси про нашу внутреннюю сеть ничего не знает.
NO_PROXY=localhost,127.0.0.1,gateway,redis,minio,clamd,bot,vs-collector,172.20.0.0/16
