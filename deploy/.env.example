# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# --- обязательно поменять ---
# Токен от @BotFather. Никому не показывайте и не кладите в git.
TELEGRAM_TOKEN=

# Секрет подписи запросов и коллбэков. Сгенерировать:
#   openssl rand -hex 32
HMAC_SECRET=

# Доступ к встроенному объектному хранилищу.
#   openssl rand -hex 16
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- версия образов ---
IMAGE_NAMESPACE=dato1
IMAGE_TAG=latest

# --- инфраструктура (менять не нужно) ---
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
RAW_BUCKET=vulnscan-raw
CLEAN_BUCKET=vulnscan-clean
CLAMD_HOST=clamd

# --- поведение ---
LOG_FORMAT=json
LOG_LEVEL=INFO
# Вердикт, когда проверку выполнить НЕ УДАЛОСЬ (упал clamd, истёк таймаут).
# На уже найденные признаки не влияет.
#   fail-closed — не пропускать | suspicious — пометить | fail-open — пропустить
DEFAULT_FAIL_MODE=suspicious

# Глубина пересборки файла. На вердикт не влияет.
#   light — быстро, но МЕТАДАННЫЕ ОСТАЮТСЯ | standard — обычный выбор
#   strict — растеризация, текстовый слой теряется
DEFAULT_CDR_PROFILE=standard

# Теневой режим: проверяем весь поток, но блокировки не применяются.
# Нужен, чтобы измерить долю ложных срабатываний, не задев пользователей.
# Отчёт: GET /v1/ops/shadow. Выключить перед боевой работой.
DEFAULT_SHADOW_MODE=false

# gVisor больше НЕ включается переменной: рантайм и адреса зависимостей должны
# меняться вместе, иначе воркеры не стартуют. Подключается отдельным файлом:
#   docker compose -f docker-compose.yml -f docker-compose.gvisor.yml up -d

# Углублённая проверка: отдельная очередь вне горячего пути.
DEEP_ENABLED=true
# Доля чистых файлов, уходящих на углублённый разбор. Нужна, чтобы измерить
# пропуски: без выборки видно только то, что нашли. 0.02 — два процента.
DEEP_SAMPLE_RATE=0.0

# Разбор всех настроек: docs/policies.md в репозитории
WAIT_MS=2000
CONCURRENCY=4

# Gateway наружу не смотрит, поэтому подпись можно не требовать.
# Если публикуете порт — обязательно true.
REQUIRE_SIGNATURE=false

# --- Наблюдаемость -----------------------------------------------------
#
# Трассировка выключена по умолчанию: без коллектора включать нечего.
# Коллектор стоит во внутренней сети и сам выносит данные в Tempo — у воркера
# сетевого выхода наружу нет, и телеметрия не повод его открывать.
OTEL_ENABLED=true
# Коллектор общего стека мониторинга: сервисы подключены к его сети напрямую.
# Вернёте воркеру изоляцию — поменяйте на http://vs-collector:4318/v1/traces
# и поднимите мост профилем `observability`.
OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
# Доля трассируемых сканов. На проде снижайте: 1.0 — это каждый файл.
OTEL_SAMPLE_RATIO=1.0

# Метрики дёшевы и внешнего адреса не требуют, поэтому включены.
# Порты слушают только во внутренней сети, наружу не публикуются.
METRICS_ENABLED=true
METRICS_PORT=9100

# Список тенантов через запятую — ТОЛЬКО для меток метрик. Тенант приходит в
# теле запроса, и без приведения к известному списку любой клиент мог бы
# наплодить рядов метрик, просто присылая новые значения.
KNOWN_TENANTS=default,telegram-bot

# Прокси для выхода наружу настраивается в отдельном файле proxy.env —
# см. deploy/proxy.env.example. В общий .env он не кладётся: этот файл читают
# все сервисы, включая воркер, который разбирает недоверенные файлы.

# --- Зеркало баз ClamAV --------------------------------------------------
#
# Наружу за базами ходит один контейнер cvdmirror, clamd берёт их у него по
# внутренней сети. Так требует сам ClamAV: их CDN банит на сутки тех, кто
# качает часто и полными файлами.
#
# Раз в четыре часа. ClamAV просит не чаще раза в час — у нас с запасом.
CVD_UPDATE_INTERVAL_S=14400

# Резолвер для проверки версии баз. cvdupdate сам спрашивает TXT-запись, чтобы
# понять, нужно ли качать, — это и есть дешёвая проверка, ради которой CDN
# просит не ходить полными файлами. Там, где системный DNS подменяют, ответ
# приходит битым («Invalid DNS reply» в логах freshclam), и следом прилетает бан.
CVD_NAMESERVER=1.1.1.1

# --- Сроки хранения в объектном хранилище -------------------------------
#
# Здесь лежат сканы паспортов и договоров. Хранилище, которое ничего не
# удаляет, со временем превращается в архив чужих документов — это риск сам
# по себе, независимо от того, вредоносны файлы или нет.
#
# Правило выставляется на стороне хранилища, а не уборщиком в коде: процесс,
# который «должен» подчищать, однажды не запустится.
RAW_RETENTION_DAYS=1
CLEAN_RETENTION_DAYS=1

# Хранить ли вредоносные семплы дольше карантина. По умолчанию нет: соблазн
# собрать коллекцию понятен, но вредоносный PDF — это всё ещё чей-то документ
# с персональными данными. Включать осознанно и с согласованной политикой.
KEEP_MALICIOUS_SAMPLES=false

# --- История проверок ----------------------------------------------------
#
# Пишет её отдельный сервис writer — он единственный, у кого есть доступ к базе.
# Воркер туда не ходит: это процесс, разбирающий враждебные файлы.
POSTGRES_DB=vulnscan
POSTGRES_USER=vulnscan
# ОБЯЗАТЕЛЬНО задать: без пароля стек не поднимется.
POSTGRES_PASSWORD=
POSTGRES_DSN=postgresql://vulnscan:ЗАМЕНИТЕ@postgres:5432/vulnscan

# Срок хранения истории. Ноль — не удалять (решать осознанно: здесь вердикты
# по документам пользователей, пусть и без имён файлов).
HISTORY_RETENTION_DAYS=90

# --- Точка входа для внешних клиентов ------------------------------------
#
# Нужна только при подключении сторонних команд. Поднимается профилем:
#   docker compose --profile public up -d
#
# Gateway сам TLS не терминирует: подпись HMAC подтверждает отправителя, но
# ничего не шифрует — по открытому каналу пошли бы и документ, и копия.
PUBLIC_DOMAIN=scan.example.com
MAX_UPLOAD_MB=64

# ОБЯЗАТЕЛЬНО true при внешнем доступе. false — только для разработки:
# загружать файлы сможет кто угодно, а тенант возьмётся из умолчания.
REQUIRE_SIGNATURE=true

# Идентификатор ключа бота. Должен совпадать с записью в config/keys.json,
# а HMAC_SECRET — с её полем secret.
KEY_ID=telegram-bot-1

# Куда мост выносит трейсы. Если рядом уже развёрнут стек Grafana/Tempo со
# своим коллектором — укажите его: vs-collector будет мостом из внутренней
# сети, а сами сервисы туда подключать не нужно и не следует.
#   TEMPO_ENDPOINT=tempo:4317
#   TEMPO_ENDPOINT=otel-collector:4317
TEMPO_ENDPOINT=tempo:4317

# Демо-сайт с формой обратной связи поднимается отдельно:
# examples/feedback-site/docker-compose.yml
