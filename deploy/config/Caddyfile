# Точка входа для внешних клиентов (ROADMAP M8.10).
#
# Gateway сам порт наружу не публикует и TLS не терминирует: подпись HMAC
# подтверждает отправителя, но ничего не шифрует — по открытому каналу пошли бы
# и документ, и обезвреженная копия.
#
# Домен задаётся переменной PUBLIC_DOMAIN. Caddy получает сертификат сам;
# для внутреннего домена подставьте `tls internal`.

{$PUBLIC_DOMAIN} {
	encode gzip

	# Служебные ручки наружу не выставляются: /readyz раскрывает состав
	# движков и размер очереди разбора, /metrics — весь профиль нагрузки.
	@internal path /metrics /readyz /healthz /v1/ops/*
	respond @internal 404

	# Административные ручки тоже не публикуются: заведение тенантов
	# выполняется из внутренней сети, а не через интернет.
	@admin path /v1/admin/*
	respond @admin 404

	reverse_proxy gateway:8080 {
		# Загрузка файла может быть медленной; ответ ждём столько же, сколько
		# клиент готов ждать синхронный вердикт.
		transport http {
			read_timeout 120s
		}
	}

	request_body {
		# Верхний предел на приёме прокси. Настоящий лимит — политика тенанта,
		# но отсекать заведомо лишнее до сервиса дешевле.
		max_size {$MAX_UPLOAD_MB:64}MB
	}

	log {
		# URL с параметрами и заголовки авторизации в лог не пишем.
		format json
		output stdout
	}
}
