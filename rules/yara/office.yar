/*
 * Правила для документов Word.
 *
 * Проверяют РАСПАКОВАННЫЕ части пакета: стадия отдаёт каждую часть отдельно,
 * а её имя — во внешней переменной `part` (worker_app/yara_views.py). По
 * сырым байтам документа правило видело бы только сжатый поток. Условие на
 * `part` обязательно: без него правило сработает на любом файле, где
 * встретится строка, включая PDF и картинки.
 *
 * Чего здесь нет намеренно: DDE, макросов, внешних шаблонов и объектов. Их
 * находит разбор структуры (stages/docx_structure.py), и надёжнее — он
 * склеивает инструкцию поля, разрезанную на куски, а байтовый поиск её не
 * находит. Правило, повторяющее разбор, удваивало бы вес одного и того же
 * поля: у признаков YARA нет семейств. Сюда идёт то, чего разбор не видит.
 *
 * Исходник макросов (`vbaProject.bin`) здесь не читается: он сжат форматом
 * MS-OVBA, и строки из макроса правило в нём не найдёт. Макросы видит clamd —
 * он разжимает их сам.
 *
 * Регулярные выражения: повтор длиннее примерно тысячи символов YARA
 * компилирует без ошибки и МОЛЧА не находит никогда (проверено: `{1020}`
 * находит, `{1023}` — нет). Каждое правило с длинным повтором обязано иметь
 * образец в `rules/check.py` — иначе такая поломка не видна ничем.
 */

rule docx_equation_editor : medium
{
    meta:
        description = "Объект редактора формул Equation 3.0 — через него шли CVE-2017-11882 и CVE-2018-0802"
    strings:
        $progid = "ProgID=\"Equation.3\""
        // CLSID {0002CE02-0000-0000-C000-000000000046} в том порядке байт,
        // в каком он записан внутри OLE-объекта.
        $clsid = { 02 CE 02 00 00 00 00 00 C0 00 00 00 00 00 00 46 }
    condition:
        ($progid and part matches /^word\/[^\/]+\.xml$/) or
        ($clsid and part matches /^word\/embeddings\//)
}

rule docx_docvar_payload : low
{
    meta:
        description = "Длинный base64 в переменной документа — там макрос держит полезную нагрузку"
    strings:
        $blob = /<w:docVar [^>]{0,200}w:val="[A-Za-z0-9+\/=]{768}/
    condition:
        part == "word/settings.xml" and $blob
}
