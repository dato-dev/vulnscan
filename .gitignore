# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ─── Секреты ─────────────────────────────────────────────────────────
#
# Шаблоны широкие намеренно: перечислять пути по одному — способ однажды
# завести файл в новом месте и закоммитить его. Примеры (*.example.*)
# под шаблоны не попадают и остаются в репозитории.
.env
*.env
.env.*
!*.example
!.env.example
keys.json
# Учётные данные приёмников обезвреженных копий (M14). Пример рядом —
# `delivery.example.json` — в git попадает, значения нет.
deploy/secrets/*.json
!deploy/secrets/*.example.json
proxy.env
*secret*

# Конфигурация сквозного стенда генерируется перед прогоном
# (tests/e2e/configure_stand.py) и в репозиторий не едет. Правила выше и так
# исключают `keys.json` и всё с `secret` в пути — здесь то же сказано явно,
# чтобы отсутствие файлов читалось как замысел, а не как потеря. Именно на
# этом упал первый прогон в CI: локально файлы были, на раннере их не было.
tests/e2e/config/*.json
tests/e2e/secrets/*.json
*.pem
*.key
!*.example.json
# Примеры манифестов. Правило `*secret*` выше ловит и `secrets.example.yaml`,
# а он обязан быть в репозитории: на него ссылаются README и тест. Найдено
# тем же способом, что и в прошлый раз, — файл есть локально, в свежем клоне
# его нет, и падает это далеко от причины.
!*.example.yaml

# ─── Тестовые данные ─────────────────────────────────────────────────
#
# Реальные вредоносные файлы в репозиторий не коммитятся — только синтетика
# и EICAR. Всё ниже генерируется скриптами и весит сотни мегабайт.
samples/generated/
corpus/pdfs/

# Личные инструменты, в выпуск не входят: генератор испорченных PDF и замеры
# задержек. От них ничего в репозитории не зависит — шлюз правил и тесты
# опираются на `corpus/`, а он остаётся (без самих PDF, строкой выше).
badpdfgen/
bench/

# ─── Рабочие каталоги ────────────────────────────────────────────────
*.log
.scratch/
tmp/

# ─── Окружение разработчика ──────────────────────────────────────────
.DS_Store
._*
.idea/
.vscode/
