# Логирование
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json (json — в проде)

# Redis: очередь + кэш вердиктов
REDIS_URL=redis://redis:6379/0

# Хранилище
STORAGE_BACKEND=s3          # s3 | local
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RAW_BUCKET=vulnscan-raw
CLEAN_BUCKET=vulnscan-clean

# Подпись запросов и коллбэков. Обязательно заменить в проде.
HMAC_SECRET=change-me-in-production

# Gateway
REQUIRE_SIGNATURE=false     # в dev удобно выключить
DEFAULT_WAIT_MS=400

# Политика тенантов — серверная настройка, клиент её не переопределяет
POLICY_FILE=/app/policies.json
WEIGHTS_FILE=/app/weights.json
# Что считать вердиктом, когда проверку выполнить НЕ УДАЛОСЬ (упал clamd,
# истёк таймаут стадии). На уже найденные признаки не влияет.
#   fail-closed — не пропускать
#   suspicious  — пометить подозрительным (по умолчанию)
#   fail-open   — пропустить как чистый; проверки может не быть вовсе
# Подробно: docs/policies.md
DEFAULT_FAIL_MODE=suspicious
DEFAULT_BLOCK_THRESHOLD=80
DEFAULT_SUSPICIOUS_THRESHOLD=30
# Насколько глубоко пересобирать файл. На вердикт не влияет.
#   light    — быстро, но МЕТАДАННЫЕ ОСТАЮТСЯ (не для персональных данных)
#   standard — текст сохранён, интерактив и метаданные убраны (по умолчанию)
#   strict   — растеризация: из исходника не остаётся ни одного объекта,
#              но теряется текстовый слой
DEFAULT_CDR_PROFILE=standard

# Теневой режим: проверяем весь поток, но блокировки не применяются.
# Нужен, чтобы измерить долю ложных срабатываний, не задев пользователей.
# Отчёт: GET /v1/ops/shadow. Выключить перед боевой работой.
DEFAULT_SHADOW_MODE=false
# Лимиты по умолчанию задаются в TenantPolicy, переопределяются в POLICY_FILE

# Worker
CONCURRENCY=4
HEARTBEAT_TTL_S=30
RECLAIM_INTERVAL_S=15
RECLAIM_MIN_IDLE_S=30
MAX_DELIVERIES=3
MAX_PARSER_CRASHES=1
ATTEMPT_TTL_S=3600
WORK_DIR=/dev/shm/vulnscan
CLAMD_HOST=clamd
CLAMD_PORT=3310
YARA_RULES_DIR=/app/rules/yara
RELOAD_INTERVAL_S=30

# TTL
VERDICT_TTL_S=604800
DLQ_STATUS_TTL_S=604800
DLQ_MAXLEN=10000
INFLIGHT_TTL_S=300
ARTIFACT_TTL_S=86400
