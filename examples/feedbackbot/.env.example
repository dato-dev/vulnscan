# Скопируйте в .env и заполните. Настоящий .env в репозиторий не попадает —
# а этот файл попадает, поэтому значений здесь нет и быть не должно.

FEEDBACKBOT_IMAGE=dato1/vulnscantg-feedbackbot:ЗАМЕНИТЕ-НА-ТЕГ

# --- Telegram ---
TELEGRAM_TOKEN=ЗАМЕНИТЕ
# Только если Telegram недоступен напрямую. Используется ТОЛЬКО для Telegram:
# к сканеру и в S3 бот идёт напрямую.
# TELEGRAM_PROXY=http://логин:пароль@прокси:3128

# --- сканер ---
SCANNER_URL=https://scan.ЗАМЕНИТЕ
SCANNER_KEY_ID=feedback-bot-1
SCANNER_SECRET=ЗАМЕНИТЕ-НЕ-КОРОЧЕ-32-СИМВОЛОВ
# Свой центр сертификации — путь к его сертификату НА СЕРВЕРЕ. Файл должен
# читаться пользователем контейнера (uid 10001): сертификат центра не
# секрет, `chmod 644` ему подходит.
# SCANNER_CA_FILE_ON_HOST=/etc/ssl/private-ca/lab-ca.crt

# --- карточки обращений в S3 ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=ЗАМЕНИТЕ
S3_PREFIX=cards/
S3_ACCESS_KEY_ID=ЗАМЕНИТЕ
S3_SECRET_ACCESS_KEY=ЗАМЕНИТЕ

LOG_FORMAT=json
LOG_LEVEL=INFO
