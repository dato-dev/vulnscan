# Скопируйте в .env и заполните. Настоящий .env в репозиторий не попадает.

IMAGE_NAMESPACE=dato1
IMAGE_TAG=latest

# --- сканер в Kubernetes ---
# Имя из HTTPRoute (deploy/k8s/base/80-httproute.yaml), по HTTPS.
SCANNER_URL=https://scan.abdullin.lab
# Для виджета: адрес, по которому сканер откроет БРАУЗЕР посетителя.
# Пусто — тот же, что SCANNER_URL.
SCANNER_PUBLIC_URL=https://scan.abdullin.lab

# Серверный ключ: им подписываются запросы сайта. Должен совпадать с записью
# в deploy/config/keys.json сканера; callback_hosts там оставьте пустым.
DEMO_KEY_ID=demo-site-1
DEMO_SECRET=

# Публичный ключ для виджета (запись с "public": true и "origins").
SCANNER_SITE_KEY=demo-site-public

# Свой центр сертификации — путь к его сертификату НА СЕРВЕРЕ. Внутрь
# контейнера он всегда попадает по одному пути, задавать его не нужно.
# Файл должен читаться пользователем контейнера (uid 10001): сертификат
# центра не секрет, `chmod 644` ему подходит. Нет своего центра — оставьте
# пустым.
SCANNER_CA_FILE_ON_HOST=/etc/ssl/private-ca/lab-ca.crt

# --- сайт ---
DEMO_PORT=8000
MAX_UPLOAD_MB=16
# METRICS_BIND=127.0.0.1
# METRICS_PORT=9108
