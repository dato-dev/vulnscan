# Ключ демо-сайта. Должен совпадать с записью в config/keys.json сканера.
#
# callback_hosts там оставьте пустым: сайт ждёт ответа опросом и вебхука
# у себя не поднимает.
DEMO_KEY_ID=demo-site-1
DEMO_SECRET=

# Порт, на котором открывается форма.
DEMO_PORT=8000

# Откуда брать образ.
IMAGE_NAMESPACE=dato1
IMAGE_TAG=latest
