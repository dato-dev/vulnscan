# Скопируйте в .env и заполните. Настоящий .env в репозиторий не попадает —
# а этот файл попадает, поэтому значений здесь нет и быть не должно.

IMAGE_NAMESPACE=dato1
IMAGE_TAG=ЗАМЕНИТЕ-НА-ТЕГ

# --- Telegram ---
TELEGRAM_TOKEN=ЗАМЕНИТЕ
# Только если Telegram недоступен напрямую. Действует ТОЛЬКО на Telegram:
# к сканеру бот идёт напрямую.
# TELEGRAM_PROXY=http://логин:пароль@прокси:3128

# --- сканер в Kubernetes ---
# Имя из HTTPRoute (deploy/k8s/base/80-httproute.yaml), по HTTPS.
SCANNER_URL=https://scan.ЗАМЕНИТЕ
# Ключ доступа: запись в deploy/config/keys.json сканера.
KEY_ID=telegram-bot-1
HMAC_SECRET=ЗАМЕНИТЕ-НЕ-КОРОЧЕ-32-СИМВОЛОВ
TENANT=telegram-bot

# Свой центр сертификации — путь к его сертификату НА СЕРВЕРЕ. Файл должен
# читаться пользователем контейнера (uid 10001): сертификат центра не
# секрет, `chmod 644` ему подходит.
# SCANNER_CA_FILE_ON_HOST=/etc/ssl/private-ca/lab-ca.crt

LOG_LEVEL=INFO
# METRICS_BIND=127.0.0.1
